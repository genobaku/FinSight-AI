# FINSIGHT AI CORE API — CONFIGURATION TEMPLATE
# DO NOT COMMIT PRODUCTION SECRETS OR PRIVATE KEYS TO VERSION CONTROL

# -------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# -------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
DEBUG=false

# -------------------------------------------------------------
# 2. PROPRIETARY API AUTHENTICATION & SECRETS
# -------------------------------------------------------------
# Comma-separated list of authorized client API keys (e.g. for finsight-ai-demo)
FINSIGHT_API_KEYS=finsight-core-live-key-2026,finsight-demo-app-key-2026

# JWT secret key for signing document session tokens
JWT_SECRET=super-secret-finsight-core-jwt-key-2026

# -------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# -------------------------------------------------------------
# PostgreSQL (Production / Supabase / Docker)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight
# SQLite (Local Development default)
DATABASE_URL=sqlite:///./finsight_core.db

# -------------------------------------------------------------
# 4. STORAGE VAULT CONFIGURATION
# -------------------------------------------------------------
STORAGE_DIR=core_api/storage_vault
MAX_FILE_SIZE_BYTES=20971520

# -------------------------------------------------------------
# 5. MODEL WEIGHTS & ARTIFACTS
# -------------------------------------------------------------
MODEL_PATH=models/production/transaction_classifier.joblib
VECTORIZER_PATH=models/production/tfidf_vectorizer.joblib

# -------------------------------------------------------------
# 6. EXTERNAL OCR / FALLBACKS (OPTIONAL)
# -------------------------------------------------------------
GEMINI_API_KEY=your-optional-gemini-api-key
